# Copy to .env.hub for local reference-stack use. Do not commit the populated file.
HUB_APP_ORIGIN=https://localhost:8443
# Optional full-Hub Cloudflare Tunnel: add compose.hub.tunnel.yml last.
# HUB_PUBLIC_DOMAIN=tools.example.com
# CLOUDFLARED_TOKEN=your-remotely-managed-tunnel-token
# Override both if the default tunnel subnet overlaps an existing network.
# HUB_TUNNEL_SUBNET=172.31.0.0/24
# HUB_TUNNEL_CONNECTOR_IP=172.31.0.10
# Standalone Portainer stack uses a managed config volume; no HUB_PROJECT_DIR needed.
# Existing default CLI volume prefix; change only to match a previous project name.
# HUB_VOLUME_PREFIX=thelemartools-hub
HUB_TRUST_PROXY=172.30.0.10
# Leave unset in the local Caddy stack. DigitalOcean App Platform uses: do-connecting-ip
# HUB_CLIENT_IP_HEADER=
HUB_POSTGRES_PASSWORD=local-owner-password
HUB_RUNTIME_DB_PASSWORD=local-runtime-password
HUB_BACKUP_DB_PASSWORD=local-backup-password
HUB_OPERATIONS_DB_PASSWORD=local-operations-password
HUB_COOKIE_SECRET=replace-with-at-least-32-random-characters
HUB_CSRF_SECRET=replace-with-a-different-32-character-secret
HUB_INVITE_TOKEN_SECRET=replace-with-an-independent-32-character-secret
# During rotation, retain prior secrets here (newest first) for at least the 24-hour receipt lifetime.
HUB_INVITE_TOKEN_PREVIOUS_SECRETS=
HUB_METRICS_TOKEN=replace-with-an-independent-32-character-token
# Optional personal login: use compose.hub.local.yml (see docs/hub/local-login.md).
# HUB_AUTH_MODE=local
# HUB_LOCAL_USERS_FILE=/run/hub/users.json
HUB_AUTH_PROVIDERS=github
# Emergency-only comma-separated kill switch. The service fails closed if no provider remains.
HUB_AUTH_EMERGENCY_DISABLED_PROVIDERS=
# Default off until the r9 campaign-creation entitlement layer is deployed and reviewed.
HUB_INVITE_ACCOUNT_ADMISSION_ENABLED=false
# Default off until migration 0009 and the entitlement rollout preflight pass.
HUB_ACCOUNT_ENTITLEMENTS_ENABLED=false
# Comma-separated internal account UUIDs. Additive reconciliation never revokes removed entries.
HUB_OPERATOR_ACCOUNT_IDS=
# Legacy pre-r9 rollback preflight only; the BFF does not receive this value.
HUB_ALLOWED_OAUTH_SUBJECTS=github:12345678
# Comma-separated exact campaign UUID rollout allowlist. Production rejects "*"; blank disables the capability.
HUB_PEER_SOURCE_COSTS_CAMPAIGN_IDS=
# Generate with: openssl rand -base64 32
HUB_BACKUP_ENCRYPTION_KEY=replace-with-base64-for-exactly-32-bytes
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUB_IMAGE_VERSION=dev
HUB_VCS_REF=local
# Override only when the environment cannot reach the public npm registry.
HUB_NPM_REGISTRY=https://registry.npmjs.org/
