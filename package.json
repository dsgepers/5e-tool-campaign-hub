{
	"name": "5etools",
	"author": "TheGiddyLimit",
	"version": "2.32.0",
	"license": "MIT",
	"description": "A site dedicated to making playing games with your friends as easy as possible.",
	"type": "module",
	"private": true,
	"scripts": {
		"version-bump": "npm version -m \"chore(version): bump\"",
		"gen": "node node/generate-all.js && npm run gen:hub-content-catalog",
		"gen:hub-content-catalog": "node server/scripts/generate-content-catalog.mjs",
		"gen:crafting": "node node/generate-crafting-data.js",
		"gen:search-index": "node node/generate-search-index.js",
		"gen:pages": "node node/generate-pages.js",
		"clean-jsons": "node node/clean-jsons.js",
		"test:js": "eslint .",
		"lint:js": "npm run test:js -- --fix",
		"lint:js:fast": "lint-js-changed --additional-root node_",
		"lint:js:single": "eslint -- ",
		"test:css:lint": "stylelint scss/*.scss scss/includes/*.scss",
		"test:css:format": "echo '(Skipping CSS format check)'",
		"test:css": "npm run test:css:lint && npm run test:css:format",
		"lint:css:lint": "npm run test:css:lint -- --fix",
		"lint:css:format": "npm run prettier:css -- --write",
		"lint:css": "npm run lint:css:format && npm run lint:css:lint",
		"test:data": "node test/test-all.js",
		"test:manual:credits": "node test/test-adventure-book-credits.js",
		"test:manual:homebrew-tags": "node test/test-homebrew-tags.js",
		"test:manual:page-numbers": "node test/test-adventure-book-pages.js",
		"test:manual:page-generator": "node test/test-page-generator.js",
		"test:manual:tags-future": "node test/test-tag-source-versions.js",
		"test:manual": "npm run test:manual:credits && npm run test:manual:page-numbers && npm run test:manual:page-generator && npm run test:manual:tags-future && npm run test:manual:homebrew-tags -- --dir \"../homebrew\"",
		"lint:data": "node node/prettify-data/prettify-data.js",
		"test:json": "node test/test-json.js",
		"test:combatmethods-schema": "node test/test-combatmethods-schema.js",
		"test:item-composition": "node test/test-item-composition.js",
		"test:tags": "node test/test-tags.js",
		"test:unit": "node --localstorage-file test/localstorage.tmp --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:e2e": "npx playwright test",
		"test:e2e:fast": "PW_WORKERS=5 PW_TIMEOUT_MS=90000 npx playwright test",
		"test:e2e:single": "PW_WORKERS=1 npx playwright test",
		"test:e2e:ui": "npx playwright test --ui",
		"test:e2e:debug": "npx playwright test --debug",
		"test:e2e:report": "npx playwright show-report",
		"perf": "node scripts/perf/measure.mjs",
		"perf:local": "node scripts/perf/measure.mjs --serve",
		"test:tgtt-party": "node --localstorage-file test/localstorage.tmp --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern='CharacterSheetTGTT(Bladesinger|MercyMonk|DivineSoul|Hexblade|HunterRanger|ArcaneArcher|ZodiacDruid|Multiclass)' --no-coverage",
		"test:tgtt-party:e2e": "npx playwright test --grep 'TGTT'",
		"test": "npm run test:js && npm run test:unit && npm run test:css && npm run test:data",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:data",
		"build:css": "sass --style=compressed scss/:css/ && node node/rm.js css/includes/ css/vars/",
		"build:seo": "node node/generate-seo.js",
		"build:sw": "node node/build-sw.mjs",
		"build:sw:prod": "node node/build-sw.mjs prod",
		"build": "npm run clean-jsons && npm run gen && npm run build:css && npm run build:sw:prod",
		"preversion": "npm test",
		"version": "node node/version-bump.js",
		"serve:dev": "http-server -c-1 --cors --port 5050",
		"serve:dev:tls": "http-server -c-1 --cors --port 5051 --tls --cert certs-dev-only/throwaway-cert.pem --key certs-dev-only/throwaway-key.pem",
		"spawn": "node scripts/spawnCharacter.mjs",
		"spellcheck:check-data": "node node/spellcheck.js",
		"spellcheck:check-data:fast": "node node/spellcheck.js --fast",
		"spellcheck:trust-data": "node node/spellcheck.js --trust",
		"spellcheck:trust-data:fast": "node node/spellcheck.js --fast --trust",
		"prettier:css": "prettier scss/**/*.scss --log-level warn",
		"prepare": "husky",
		"hooks:precommit": "node scripts/hooks/run-precommit.mjs",
		"hooks:prepush": "node scripts/hooks/run-prepush.mjs",
		"hooks:e2e-smoke": "node scripts/hooks/run-e2e-smoke.mjs",
		"hub:user": "node server/scripts/local-user.mjs",
		"hub:serve": "node server/src/index.js",
		"hub:migrate": "node server/scripts/migrate.mjs",
		"hub:migrate:plan": "node server/scripts/migrate.mjs plan",
		"hub:migrate:status": "node server/scripts/migrate.mjs status",
		"hub:grant-roles": "node server/scripts/grant-roles.mjs",
		"hub:purge-accounts": "node server/scripts/purge-accounts.mjs",
		"hub:maintenance": "node server/scripts/maintenance.mjs",
		"hub:check-secrets": "node server/scripts/check-secrets.mjs",
		"hub:check-auth-rollback": "node server/scripts/check-auth-provider-rollback.mjs",
		"hub:check-multi-target-rollback": "node server/scripts/check-multi-target-rollback.mjs",
		"hub:check-auth-first-enable": "node server/scripts/check-auth-provider-first-enable.mjs",
		"hub:check-account-entitlements": "node server/scripts/check-account-entitlement-rollout.mjs",
		"hub:check-peer-source-cost-rollout": "node server/scripts/check-peer-source-cost-rollout.mjs",
		"hub:backup": "node server/scripts/backup.mjs",
		"hub:backup:encrypted": "node server/scripts/backup-encrypted.mjs",
		"hub:restore": "node server/scripts/restore.mjs",
		"hub:restore:encrypted": "node server/scripts/restore-encrypted.mjs",
		"hub:restore:baseline": "node server/scripts/restore-drill-baseline.mjs",
		"hub:restore:finalize": "node server/scripts/finalize-restore-drill.mjs",
		"test:hub": "node --localstorage-file test/localstorage.tmp --experimental-vm-modules node_modules/jest/bin/jest.js test/jest/hub/ --no-coverage --forceExit",
		"test:hub:ops-image": "node scripts/test-hub-ops-image-permissions.mjs",
		"test:hub:mutations": "node scripts/test-hub-active-context-mutations.mjs && node scripts/test-hub-rules-policy-mutations.mjs && node scripts/test-hub-content-policy-mutations.mjs && node scripts/test-hub-account-entitlement-mutations.mjs && node scripts/test-hub-account-identity-mutations.mjs && node scripts/test-hub-semantic-operation-mutations.mjs && node scripts/test-hub-multi-target-mutations.mjs",
		"test:hub:e2e:stack": "node server/scripts/run-hub-e2e.mjs"
	},
	"lint-staged": {
		"*.{js,cjs,mjs}": "eslint --fix --no-warn-ignored",
		"*.scss": "stylelint --fix --allow-empty-input",
		"data/**/*.json": "node scripts/hooks/check-json-syntax.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/5etools-mirror-3/5etools-src"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.2",
		"5etools-utils": "^0.16.15",
		"ajv": "^8.18.0",
		"ajv-formats": "^3.0.1",
		"commander": "^14.0.3",
		"cspell-lib": "^9.6.4",
		"esbuild": "^0.27.3",
		"eslint": "^10.0.1",
		"globals": "^17.3.0",
		"handlebars": "^4.7.8",
		"http-server": "^14.1.1",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"json-source-map": "^0.6.1",
		"lint-staged": "^17.0.4",
		"prettier": "^3.8.1",
		"probe-image-size": "^7.2.3",
		"readline-sync": "^1.4.10",
		"sass": "^1.97.3",
		"sharp": "^0.34.5",
		"simple-git": "^3.32.1",
		"stylelint": "^17.3.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"tinybench": "^6.0.0",
		"workbox-cli": "^7.4.0"
	},
	"bugs": {
		"url": "https://github.com/5etools-mirror-3/5etools-src/issues"
	},
	"homepage": "https://github.com/5etools-mirror-3/5etools-src#readme",
	"directories": {
		"lib": "lib",
		"test": "test"
	},
	"dependencies": {
		"@fastify/cookie": "11.1.2",
		"@fastify/rate-limit": "11.2.0",
		"@fastify/websocket": "11.3.0",
		"fastify": "5.12.5",
		"jose": "6.2.10",
		"pg": "8.23.0",
		"sanitize-html": "2.17.7"
	}
}
